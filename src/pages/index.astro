---
import '@fontsource/arimo/400.css';
import '@fontsource/arimo/500.css';
import '@fontsource/arimo/600.css';
import '@fontsource/arimo/700.css';
import '@/styles/global.css';
import { SmoothScroll } from '@/components/smooth-scroll';
import { Header } from '@/components/sections/Header';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Vanessa Ariel - Gestão de RH</title>
  </head>
  <body class="min-h-screen">
    <SmoothScroll client:load />
    <Header client:load />
    <main>
      <section id="inicio" class="flex min-h-screen items-center justify-center bg-surface-container-lowest scroll-mt-20">
        <p class="text-body-lg text-on-surface-variant">Hero — Fase 3</p>
      </section>
      <section id="servicos" class="flex min-h-[60vh] items-center justify-center scroll-mt-20">
        <p class="text-body-lg text-on-surface-variant">Serviços — Fase 4</p>
      </section>
      <section id="sobre" class="flex min-h-[60vh] items-center justify-center bg-surface-container-lowest scroll-mt-20">
        <p class="text-body-lg text-on-surface-variant">Sobre — Fase 5</p>
      </section>
      <section id="contato" class="flex min-h-[60vh] items-center justify-center scroll-mt-20">
        <p class="text-body-lg text-on-surface-variant">Contato — Fase 6</p>
      </section>
    </main>
  </body>
</html>
