---
import '@fontsource/arimo/400.css';
import '@fontsource/arimo/500.css';
import '@fontsource/arimo/600.css';
import '@fontsource/arimo/700.css';
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import heroSection from '@/assets/hero-section.webp';
import aboutWorkshop from '@/assets/about-workshop.jpg';
import pillarsSection from '@/assets/pilares-section.webp';
import { SmoothScroll } from '@/components/smooth-scroll';
import { Header } from '@/components/sections/Header';
import { Hero } from '@/components/sections/Hero';
import { About } from '@/components/sections/About';
import { Pillars } from '@/components/sections/Pillars';
import { Services } from '@/components/sections/Services';
import { Contact } from '@/components/sections/Contact';
import { Footer } from '@/components/sections/Footer';
import { MobileNav } from '@/components/sections/MobileNav';
import { LGPDBanner } from '@/components/sections/LGPDBanner';
import { WhatsAppFloat } from '@/components/sections/WhatsAppFloat';

const aboutImage = await getImage({
  src: aboutWorkshop,
  widths: [480, 768, 1024],
  sizes: '(max-width: 768px) 100vw, 50vw',
  format: 'webp',
});
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Vanessa Ariel - Gestão de RH</title>
  </head>
  <body class="min-h-screen pb-16 md:pb-0">
    <SmoothScroll client:load />
    <Header client:load />
    <main>
      <Hero client:load background={heroSection} />
      <About
        client:visible
        image={{
          src: aboutImage.src,
          srcSet: aboutImage.srcSet,
          sizes: aboutImage.sizes,
          width: aboutImage.width,
          height: aboutImage.height,
        }}
      />
      <Pillars client:visible background={pillarsSection} />
      <Services client:visible />
      <Contact client:visible />
    </main>
    <Footer />
    <MobileNav client:load />
    <WhatsAppFloat client:load />
    <LGPDBanner client:load />
  </body>
</html>
